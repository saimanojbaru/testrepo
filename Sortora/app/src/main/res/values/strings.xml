    <!-- Privacy -->
    <string name="privacy_banner_title">Fully offline · Local AI</string>
    <string name="privacy_banner_body">Sortora has no internet permission. Every photo and video is analysed by on-device models and never leaves your phone.</string>

    <!-- Onboarding -->
    <string name="onboarding_1_title">Sort your footage, automatically</string>
    <string name="onboarding_1_body">Pick photos, videos or screenshots. Sortora looks at them and suggests clear names and tidy folders, like 2025-10-12_talkinghead_person_desk.mp4.</string>
    <string name="onboarding_2_title">100% on your device</string>
    <string name="onboarding_2_body">All analysis runs with AI models built into the app. Sortora doesn\'t even have permission to use the internet, so nothing can be uploaded. No accounts, no API keys, no cloud.</string>
    <string name="onboarding_3_title">You stay in control</string>
    <string name="onboarding_3_body">Preview every new name and folder before anything happens. Sortora copies by default, and only removes originals if you choose Move and confirm.</string>

