<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nonverbal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Nonverbal.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mark_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Nonverbal</item>
    </style>
</resources>
