{
  "chapter_id": "chapter_01_innocent_spark",
  "start": "morning_routine",
  "knots": {
    "morning_routine": {
      "lines": [
        { "mood": "ch1_innocent", "mood_fade": 1.5, "speaker": "", "text": "Tier-2 city. Early morning. Sunlight slants through a wooden window grill." },
        { "speaker": "Maa", "text": "Beta, uth jao! School ki bus aane wali hai." },
        { "speaker": "", "text": "Maa hands you a steel tiffin box, still warm." },
        { "speaker": "Maa", "text": "Aloo paratha. Tumhara favourite." }
      ],
      "choices": [
        { "text": "Thanks Maa!",            "effects": [{"stat":"family_bond","delta":3},{"stat":"happiness","delta":2}], "goto": "papa_asks_about_test" },
        { "text": "Not aloo paratha again?", "effects": [{"stat":"social_charm","delta":2},{"stat":"family_bond","delta":-2}], "goto": "papa_asks_about_test" }
      ]
    },
    "papa_asks_about_test": {
      "lines": [
        { "speaker": "", "text": "Papa lowers his newspaper." },
        { "speaker": "Papa", "text": "Aaj test hai na? Tayyari ho gayi?" }
      ],
      "choices": [
        { "text": "I'll make you proud, Papa!",
          "effects": [{"stat":"discipline","delta":12},{"stat":"happiness","delta":-4}],
          "goto": "walk_to_school" },
        { "text": "I studied... mostly.",
          "effects": [{"stat":"discipline","delta":4},{"stat":"social_charm","delta":3}],
          "goto": "walk_to_school" },
        { "text": "I want to invent something new today!",
          "effects": [{"stat":"creativity","delta":10},{"stat":"curiosity","delta":6},{"stat":"discipline","delta":-4}],
          "goto": "walk_to_school" }
      ]
    },
    "walk_to_school": {
      "lines": [
        { "mood": "ch1_innocent", "speaker": "", "text": "The morning is warm. Pollen drifts through slanted sunlight." },
        { "speaker": "", "text": "You walk to the bus stop, tiffin clutched tight." }
      ],
      "goto": "first_big_test"
    },
    "first_big_test": {
      "lines": [
        { "mood": "ch1_exam_focus", "mood_fade": 2.0, "speaker": "", "text": "Exam Hall. Ceiling fan ticks overhead. Pencils scratch." },
        { "speaker": "", "text": "[Mini-game: Exam Puzzle — placeholder. Press continue.]" }
      ],
      "goto": "power_cut_study_night"
    },
    "power_cut_study_night": {
      "lines": [
        { "mood": "ch1_power_cut", "mood_fade": 6.0, "speaker": "", "text": "The lights cut out at 8:47 PM." },
        { "speaker": "", "text": "You light the emergency lamp. Moths gather almost instantly." },
        { "speaker": "Maa", "text": "Beta, doodh leke aayi hoon. Thoda break le lo." }
      ],
      "goto": "family_financial_strain"
    },
    "family_financial_strain": {
      "lines": [
        { "mood": "ch1_family_strain", "mood_fade": 5.0, "speaker": "", "text": "Papa is sitting on the floor with the household account book." },
        { "speaker": "", "text": "Maa is folding clothes nearby, very quietly." },
        { "speaker": "Papa", "text": "Is mahine thoda tight hai. Naya school bag agle mahine." }
      ],
      "choices": [
        { "text": "I understand. I'll study harder so I get a scholarship.",
          "effects": [{"stat":"family_bond","delta":15},{"stat":"discipline","delta":8},{"stat":"financial_awareness","delta":5}],
          "goto": "chapter_end" },
        { "text": "Okay, Papa. [Stay silent.]",
          "effects": [{"stat":"happiness","delta":6},{"stat":"family_bond","delta":-2}],
          "goto": "chapter_end" },
        { "text": "Papa, can we start a small shop like uncle?",
          "effects": [{"stat":"curiosity","delta":12},{"stat":"financial_awareness","delta":10},{"stat":"creativity","delta":5}],
          "goto": "chapter_end" }
      ]
    },
    "chapter_end": {
      "lines": [
        { "mood": "ch1_innocent", "mood_fade": 8.0, "speaker": "", "text": "Years pass in a blur of textbooks, tuition classes, and evenings on the balcony watching kites cut each other down." },
        { "speaker": "", "text": "At 15, you crack the entrance exam." },
        { "speaker": "", "text": "The family hugs you. Maa cries. Papa pretends he isn't." }
      ]
    }
  }
}
